{
  "manifest_version": 3,
  "name": "Winter Theme",
  "version": "2.0",
  "description": "Переключатель зимней темы для сайта КАИ",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://kai.ru/*",
        "https://kai.ru/for-students/*",
        "https://kai.ru/education/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}