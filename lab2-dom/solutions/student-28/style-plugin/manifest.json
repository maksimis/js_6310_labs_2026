{
  "manifest_version": 3,
  "name": "KAI Steampunk",
  "version": "1.0",
  "description": "Стимпанк и викторианская эстетика для сайта kai.ru (Студент 28)",
  "content_scripts": [
    {
      "matches": [
        "*://kai.ru/*",
        "*://www.kai.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
