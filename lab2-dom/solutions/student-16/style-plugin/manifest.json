{
  "manifest_version": 3,
  "name": "KAI to CYBERPUNK",
  "version": "1.0",
  "description": "Добавляет кнопку для переключения неоновой темы Cyberpunk / Neon Noir",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://kai.ru/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}