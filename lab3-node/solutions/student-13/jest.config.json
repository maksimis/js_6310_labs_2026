{
  "bail": 1,
  "verbose": false,
  "testEnvironment": "node",
  "collectCoverageFrom": ["src/**/*.js"],
  "coveragePathIgnorePatterns": ["src/index.js"],
  "coverageDirectory": "coverage",
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70
    }
  }
}
