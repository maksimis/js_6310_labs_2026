{
  "name": "quizbot",
  "version": "1.0.0",
  "description": "Telegram quiz bot with multiple modes and a records table",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint . --max-warnings 0",
