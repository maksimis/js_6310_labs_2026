{
  "bail": 1,
  "verbose": false,
  "testEnvironment": "node",
  "transform": {},
  "collectCoverageFrom": ["src/**/*.{js,jsx,ts,tsx}"],
  "coveragePathIgnorePatterns": ["src/index.js"],
  "coverageDirectory": "coverage",
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  }
}
