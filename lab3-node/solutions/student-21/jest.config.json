{
  "bail": 1,
  "verbose": false,
  "collectCoverageFrom": ["src/**/*.{js,jsx,ts,tsx}"],
  "coveragePathIgnorePatterns": ["src/index.js"],
  "coverageDirectory": "coverage",
  "coverageThreshold": {
    "global": {
      "statements": 70,
      "branches": 70,
      "functions": 70,
      "lines": 70
    }
  }
}